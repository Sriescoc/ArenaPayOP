{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user registration data including Chilean RUT.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "firstName": { "type": "string", "description": "User's first name" },
        "lastName": { "type": "string", "description": "User's last name" },
        "rut": { "type": "string", "description": "Chilean RUT (formatted)" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["uid", "firstName", "lastName", "rut", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document indexed by Auth UID."
    }
  }
}
